# 默认按文本处理，仓库内统一 LF
* text=auto eol=lf

# 服务器端脚本必须是 LF —— CRLF 会让 Linux 报 "bad interpreter: /bin/bash^M"
server/*        text eol=lf
*.sh            text eol=lf
bridge-install.sh text eol=lf

# Windows 专用，必须 CRLF
*.bat           text eol=crlf
*.ps1           text eol=crlf

# 二进制
*.png binary
*.zip binary

# Electron / 网页界面
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
