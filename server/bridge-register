#!/bin/bash
# bridge-register --name <名> --os <windows|macos|linux> --user <用户名>
#                 [--tool-dir <路径>] [--status-local <路径>] [--label <说明>] [--port <端口>]
#
# 由客户端在建立隧道前自动调用：客户端把自己的身份上报，服务器分配端口并建档。
# 输出形如  PORT=2224  供客户端解析。已存在则返回原端口（幂等）。
. /usr/local/lib/ferry/lib.sh
NAME=""; OS=""; USER_=""; TOOL=""; SLOCAL=""; LABEL=""; PORT=""; REALLOC=""
while [ $# -gt 0 ]; do
  case "$1" in
    --name) NAME="$2"; shift 2 ;;
    --os) OS="$2"; shift 2 ;;
    --user) USER_="$2"; shift 2 ;;
    --tool-dir) TOOL="$2"; shift 2 ;;
    --status-local) SLOCAL="$2"; shift 2 ;;
    --label) LABEL="$2"; shift 2 ;;
    --port) PORT="$2"; shift 2 ;;
    # 存着的端口被别人占了时用：忽略旧值，重新挑一个空的。
    # 不加这个的话，客户端拿回来的永远是那个占用中的端口，
    # 隧道会一直 remote port forwarding failed，出不来。
    --realloc) REALLOC=1; shift ;;
    *) echo "ERR|未知参数: $1"; exit 1 ;;
  esac
done
[ -z "$NAME" ] || [ -z "$OS" ] || [ -z "$USER_" ] && {
  echo "ERR|--name --os --user 必填"; exit 1; }
# 名字消毒，避免路径穿越
NAME=$(printf '%s' "$NAME" | tr -cd '[:alnum:]._-' | cut -c1-40)
[ -z "$NAME" ] && { echo "ERR|名字非法"; exit 1; }

CONF="$FERRY_HOME/clients/${NAME}.conf"
mkdir -p "$FERRY_HOME"/clients

OLDPORT=""
if [ -f "$CONF" ]; then
  OLDPORT=$(sed -n 's/^PORT=//p' "$CONF" | sed 's/#.*//; s/[[:space:]]//g' | head -1)
fi
[ -z "$PORT" ] && [ -z "$REALLOC" ] && PORT="$OLDPORT"

if [ -z "$PORT" ]; then
  # 已被别的客户端登记的，以及此刻真的在监听的，都跳过。
  # 重新分配时要把自己那条排除掉，否则会原地打转选回同一个端口。
  # 自己这个角色已登记的 + 别的角色占着的（共享登记表）+ 此刻真在监听的。
  # 端口是整机全局资源，只看自己家目录会和别的角色撞车。
  USED=$(printf '%s\n%s\n' \
         "$(grep -h '^PORT=' "$FERRY_HOME"/clients/*.conf 2>/dev/null \
            | cut -d= -f2 | sed 's/#.*//; s/[[:space:]]//g')" \
         "$(bridge_ports_taken "$NAME")" | grep -E '^[0-9]+$')
  [ -n "$REALLOC" ] && [ -n "$OLDPORT" ] && USED=$(echo "$USED" | grep -vx "$OLDPORT")
  PORT=2222
  while echo "$USED" | grep -qx "$PORT" || ss -tln 2>/dev/null | grep -q ":$PORT "; do
    PORT=$((PORT + 1))
    [ "$PORT" -gt 2299 ] && { echo "ERR|2222-2299 全被占用，无法分配端口"; exit 1; }
  done
  [ -n "$REALLOC" ] && [ -n "$OLDPORT" ] && [ "$PORT" != "$OLDPORT" ] &&
    echo "NOTE|端口 $OLDPORT 已被占用，改分配 $PORT"
fi

[ -z "$TOOL" ] && case "$OS" in
  windows) TOOL='C:\bridge-console' ;;
  *)       TOOL="/home/$USER_/bridge-console" ;;
esac
[ -z "$SLOCAL" ] && case "$OS" in
  windows) SLOCAL="${TOOL}\\status\\${NAME}" ;;
  *)       SLOCAL="${TOOL}/status/${NAME}" ;;
esac
# 没传的字段沿用档案里已有的值 —— 客户端重连时只带必填项，
# 不这样做的话每次重新登记都会把显示名冲成机器名。
if [ -f "$CONF" ]; then
  [ -z "$LABEL" ] && LABEL=$(sed -n "s/^LABEL='\(.*\)'$/\1/p" "$CONF" | head -1)
fi
[ -z "$LABEL" ] && LABEL="$NAME"

cat > "$CONF" <<CFGEOF
NAME=$NAME
OS=$OS
USER=$USER_
PORT=$PORT
LABEL='$LABEL'
TOOL_DIR='$TOOL'
STATUS_LOCAL='$SLOCAL'
CFGEOF
mkdir -p "$FERRY_HOME/status/$NAME" "$FERRY_MNT/$NAME"
[ -f "$FERRY_HOME"/current ] || echo "$NAME" > "$FERRY_HOME"/current

bridge_port_claim "$NAME" "$PORT"
echo "PORT=$PORT"
echo "NAME=$NAME"
# 把服务器这边的路径告诉客户端 —— 角色账户下这些不再是 /root/...，
# 客户端如果自己拼死路径，会去创建它根本没权限的目录。
echo "MNT_ROOT=$FERRY_MNT/$NAME"
echo "STATUS_MP=$FERRY_HOME/status/$NAME"
echo "OK|已登记 $NAME ($OS/$USER_) 端口 $PORT"
