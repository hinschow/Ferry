#!/bin/bash
# bridge-check [-c 客户端]   不带 -c 则检查全部
. /usr/local/lib/ferry/lib.sh
check_one() {
  local conf="$1"; ( . "$conf"
    CLIENT="$NAME"; MNT_ROOT="$FERRY_MNT/$CLIENT"; STATUS_DIR="$FERRY_HOME/status/$CLIENT"
    printf '\n══ %s (%s / %s) ══\n' "$CLIENT" "$OS" "$LABEL"
    if ss -tln 2>/dev/null | grep -q ":$PORT "; then echo "  隧道端口 $PORT   ✅ 已监听"
    else echo "  隧道端口 $PORT   ❌ 未监听 —— 该机器未建立隧道"; return 1; fi
    local probe
    if [ "$OS" = "windows" ]; then probe='Write-Output OK'; else probe='echo OK'; fi
    if bridge-run -c "$CLIENT" "$probe" 2>/dev/null | grep -q OK; then echo "  免密登录     ✅ 成功"
    else echo "  免密登录     ❌ 失败"; return 1; fi
    local n; n=$(bridge-mounts -c "$CLIENT" | wc -l)
    echo "  挂载数量     $n"
    local f="$STATUS_DIR/.bridge-status.json"
    if [ -f "$f" ]; then
      local ts; ts=$(grep -o '"ts":[0-9]*' "$f" 2>/dev/null | cut -d: -f2 | head -1)
      # 撞上写入空窗（旧版守护是截断重写）就等一拍再读一次
      [ -z "$ts" ] && { sleep 1; ts=$(grep -o '"ts":[0-9]*' "$f" 2>/dev/null | cut -d: -f2 | head -1); }
      [ -n "$ts" ] && echo "  状态管道     ✅ $(( $(date +%s) - ts ))秒前" || echo "  状态管道     ⚠️ 文件异常"
    else echo "  状态管道     ⚠️ 未挂载（客户端会回退 SSH 探测）"; fi
  )
}
if [ "$1" = "-c" ]; then check_one "$FERRY_HOME/clients/$2.conf"
else
  for f in "$FERRY_HOME"/clients/*.conf; do check_one "$f"; done
  # 管理员视角：独立角色的客户端档案在各自家目录，root 这边扫不到，单独列。
  # 它们的挂载受 FUSE 保护，root 直接 ls 会被拒 —— 要看内容用 bridge-as。
  if [ "$(id -u)" = 0 ] && getent group ferry >/dev/null 2>&1; then
    FGID=$(getent group ferry | cut -d: -f3)
    # 主组成员不出现在 /etc/group 的成员列里（useradd -g ferry 设的正是主组），
    # 所以要按 GID 扫 passwd，再并上补充组成员
    ROLES=$(printf '%s\n%s\n' \
            "$(getent passwd | awk -F: -v g="$FGID" '$4==g{print $1}')" \
            "$(getent group ferry | cut -d: -f4 | tr ',' '\n')" | grep -v '^$' | sort -u)
    first=1
    for u in $ROLES; do
      h=$(getent passwd "$u" | cut -d: -f6); [ -d "$h" ] || continue
      [ "$first" = 1 ] && { echo; echo "══ 独立角色（挂载在各自家目录，用 bridge-as 查看）══"; first=0; }
      n=$(awk -v p="$h/mnt/" '$3=="fuse.sshfs" && index($2,p)==1' /proc/mounts | wc -l)
      pipe=$(awk -v p="$h/.winbridge/status/" '$3=="fuse.sshfs" && index($2,p)==1' /proc/mounts | wc -l)
      printf "  %-22s 挂载 %-3s 状态管道 %s\n" "$u" "$n" \
             "$([ "$pipe" -gt 0 ] && echo ✅ || echo ⚠️ 未挂载)"
    done
  fi
fi

# ── 会话恢复风险 ──────────────────────────────────────────────
# 引用了大量挂载文件的会话，重开时每个文件冷 stat ~440ms（已删除的也算），
# 超过 60 秒加载限制就被杀，表现为「标签页自动关闭、会话打不开」。
# 在这里主动点名 + 给出救法，用户不需要事先知道这个坑。
MPS=$(awk '$3=="fuse.sshfs"{gsub(/\\040/," ",$2); print $2}' /proc/mounts | grep -v "/.winbridge/status/")
if [ -n "$MPS" ] && ls "$HOME"/.claude/projects/*/*.jsonl >/dev/null 2>&1; then
  FIRST=1
  for f in "$HOME"/.claude/projects/*/*.jsonl; do
    [ "$(stat -c%s "$f" 2>/dev/null || echo 0)" -gt 2000000 ] || continue
    REFS=$(while IFS= read -r mp; do
             grep -aoE "$(printf '%s' "$mp" | sed 's/[].[^$*\\]/\\&/g')/[^\"[:space:]\\\\]+" "$f" 2>/dev/null
           done <<< "$MPS" | sort -u | wc -l)
    [ "$REFS" -ge 100 ] || continue
    EST=$((REFS * 44 / 100))
    [ "$FIRST" = 1 ] && { echo; echo "══ 会话恢复风险（重开这些会话会超时被杀）══"; FIRST=0; }
    printf "  %s…  引用 %s 个挂载文件，冷恢复约 %ss（限制 60s）\n" \
           "$(basename "$f" .jsonl | cut -c1-8)" "$REFS" "$EST"
  done
  [ "$FIRST" = 0 ] && echo "  救法：bridge-pause -c <机器> 120  → 趁窗口重开会话，到点自动挂回"
fi
