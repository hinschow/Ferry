#!/bin/bash
# bridge-invite [--name <显示名>] [--host <对外地址>] [--revoke <客户端名>]
#
# 生成一段「接入码」：在客户端控制台里粘贴即可完成全部配置。
# 码里包含：服务器地址、服务器公钥（授权到客户端本机）、
#          一把专供该客户端登录本服务器的私钥。
#
# ⚠️ 接入码等同于本服务器的登录凭据，只发给你信任的机器。
set -e
NAME=""; HOST=""; REVOKE=""; LIST=""; SHOW=""
while [ $# -gt 0 ]; do
  case "$1" in
    --name) NAME="$2"; shift 2 ;;
    --host) HOST="$2"; shift 2 ;;
    --revoke) REVOKE="$2"; shift 2 ;;
    --list|-l) LIST=1; shift ;;
    --show) SHOW="$2"; shift 2 ;;
    *) echo "用法: bridge-invite [--name 名字] [--host 对外地址]"
       echo "      bridge-invite --list              列出已发放的接入码"
       echo "      bridge-invite --show <名字>       重新显示已有的接入码"
       echo "      bridge-invite --revoke <名字>     撤销某台机器"
       exit 1 ;;
  esac
done

KEYDIR=/root/.winbridge/invites
mkdir -p "$KEYDIR"; chmod 700 "$KEYDIR"

# ---- 列出 ----
if [ -n "$LIST" ]; then
  n=0
  printf "  %-22s %-12s %s\n" "名字" "状态" "发放时间"
  printf "  %-22s %-12s %s\n" "──────────────────────" "────────────" "───────────────────"
  for f in "$KEYDIR"/*.pub; do
    [ -e "$f" ] || continue
    nm=$(basename "$f" .pub)
    fp=$(awk '{print $2}' "$f")
    if grep -qF "$fp" /root/.ssh/authorized_keys 2>/dev/null; then st="✅ 有效"; else st="⚪ 已失效"; fi
    printf "  %-22s %-12s %s\n" "$nm" "$st" "$(date -r "$f" '+%Y-%m-%d %H:%M')"
    n=$((n+1))
  done
  [ "$n" = 0 ] && echo "  （还没有发放过接入码）"
  echo
  echo "  撤销某台： bridge-invite --revoke <名字>"
  exit 0
fi

# ---- 撤销 ----
if [ -n "$REVOKE" ]; then
  K="$KEYDIR/$REVOKE"
  [ -f "$K.pub" ] || { echo "找不到该接入码: $REVOKE"; exit 1; }
  FP=$(awk '{print $2}' "$K.pub")
  grep -vF "$FP" /root/.ssh/authorized_keys > "$KEYDIR/.tmp" 2>/dev/null || true
  mv "$KEYDIR/.tmp" /root/.ssh/authorized_keys
  chmod 600 /root/.ssh/authorized_keys
  rm -f "$K" "$K.pub"
  echo "已撤销 $REVOKE —— 该客户端不再能登录本服务器"
  exit 0
fi

# ---- 重新显示已有接入码 ----
if [ -n "$SHOW" ]; then
  NAME=$(printf '%s' "$SHOW" | tr -cd '[:alnum:]._-' | cut -c1-32)
  [ -f "$KEYDIR/$NAME" ] || { echo "找不到接入码: $NAME"; echo "  用 bridge-invite --list 看已有的"; exit 1; }
  FP=$(awk '{print $2}' "$KEYDIR/$NAME.pub")
  grep -qF "$FP" /root/.ssh/authorized_keys 2>/dev/null || {
    echo "接入码 $NAME 已被撤销，无法再使用。"
    echo "  重新发放： bridge-invite --name $NAME"; exit 1; }
else
  [ -z "$NAME" ] && NAME="client-$(date +%m%d%H%M)"
  NAME=$(printf '%s' "$NAME" | tr -cd '[:alnum:]._-' | cut -c1-32)

  # ---- 重名保护：同名会共享同一把钥匙，撤销时一起失效，所以直接拦住 ----
  if [ -f "$KEYDIR/$NAME.pub" ]; then
    FP=$(awk '{print $2}' "$KEYDIR/$NAME.pub")
    if grep -qF "$FP" /root/.ssh/authorized_keys 2>/dev/null; then ST="仍然有效"; else ST="已被撤销"; fi
    # 找一个可用的替代名
    i=2; SUG="$NAME-$i"
    while [ -f "$KEYDIR/$SUG.pub" ]; do i=$((i+1)); SUG="$NAME-$i"; done
    cat >&2 <<DUPEOF

✗ 接入码 "$NAME" 已存在（$ST，发放于 $(date -r "$KEYDIR/$NAME.pub" '+%Y-%m-%d %H:%M')）

  同名会让两台机器共用一把钥匙 —— 撤销任一台，另一台也会一起失效。
  请从下面三条里选一条：

    1) 换个名字           bridge-invite --name $SUG
    2) 重新显示原来那张   bridge-invite --show $NAME
    3) 先吊销再重发       bridge-invite --revoke $NAME && bridge-invite --name $NAME

  已有的接入码： bridge-invite --list

DUPEOF
    exit 1
  fi
fi
[ -z "$HOST" ] && HOST=$(curl -s -m 5 ifconfig.me 2>/dev/null || hostname -I | awk '{print $1}')
[ -z "$HOST" ] && { echo "取不到本机对外地址，请用 --host 指定"; exit 1; }

# ---- 客户端登录本服务器用的密钥（每张接入码一把，可单独撤销）----
K="$KEYDIR/$NAME"
if [ ! -f "$K" ]; then
  ssh-keygen -t ed25519 -f "$K" -N '' -C "ferry-invite-$NAME" -q
  mkdir -p /root/.ssh && chmod 700 /root/.ssh
  touch /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys
  cat "$K.pub" >> /root/.ssh/authorized_keys
fi

# ---- 服务器公钥（客户端要授权它，服务器才能回连）----
SRVPUB=$(cat /root/.ssh/id_bridge.pub 2>/dev/null || cat /root/.ssh/id_win.pub 2>/dev/null)
[ -z "$SRVPUB" ] && { echo "找不到服务器公钥，请先跑 bridge-install.sh"; exit 1; }

TOKEN=$(python3 - "$HOST" "$NAME" "$SRVPUB" "$K" <<'PY'
import base64, json, sys, zlib
host, name, srvpub, keypath = sys.argv[1:5]
payload = {
    "v": 1,
    "host": host,
    "port": 22,
    "user": "root",
    "name": name,
    "srv_pub": srvpub.strip(),
    "cli_key": open(keypath, encoding="utf-8").read(),
}
raw = json.dumps(payload, separators=(",", ":")).encode()
print("FERRY1:" + base64.urlsafe_b64encode(zlib.compress(raw, 9)).decode())
PY
)

[ -n "$SHOW" ] && TITLE="接入码（重新显示）" || TITLE="接入码已生成"
cat <<TIPEOF

════════════════════════════════════════════════════════════════
  $TITLE    服务器 $HOST    标识 $NAME
════════════════════════════════════════════════════════════════

$TOKEN

────────────────────────────────────────────────────────────────
  用法：打开客户端 → 「添加服务器…」→ 选「粘贴接入码」→ 粘贴上面整段

  ⚠️ 这段码包含本服务器的登录凭据，只发给你信任的机器。
     查看全部： bridge-invite --list
     再看这张： bridge-invite --show $NAME
     吊销这台： bridge-invite --revoke $NAME
════════════════════════════════════════════════════════════════
TIPEOF
